# RAPT portal login email, and an API secret from My Account > API Secrets
RAPT_EMAIL=you@example.com
RAPT_SECRET=

MQTT_HOST=192.168.0.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Set to true (and MQTT_PORT=8883) if the broker is not on a trusted network
MQTT_TLS=false

# Seconds between polls (minimum 60, RAPT recommends being gentle)
POLL_INTERVAL=300

# Optional
# BASE_TOPIC=rapt2mqtt
# HA_DISCOVERY_PREFIX=homeassistant
# LOG_LEVEL=INFO
